# ── Node ────────────────────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ── Env / secrets — never commit real keys ─────────────────────────────────
.env
.env.*
!.env.example

# ── Supabase CLI state — never commit ──────────────────────────────────────
# `supabase link` writes its link state under .temp/, and those vectors can
# carry connection credentials (e.g. a pooler URL). The official docs are
# explicit: commit config.toml · migrations/ · seed.sql — NOT .temp/ or
# .branches/, which are CLI-internal state.
supabase/.temp/
supabase/.branches/

# ── Expo / React Native (once the app is scaffolded — ADR-001) ──────────────
.expo/
dist/
web-build/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# ── Build output ────────────────────────────────────────────────────────────
build/
dist/

# ── Editors / OS ────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/*
!.vscode/extensions.json

# ── AI agent state (Cline) — local to this machine, never commit ────────────
# Cline workspace rules live here; each session/machine keeps its own copy.
.cline/

# ── Logs ────────────────────────────────────────────────────────────────────
*.log
