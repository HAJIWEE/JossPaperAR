{
  "name": "josspaperar",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "expo": "~57.0.26",
    "expo-constants": "~57.0.20",
    "expo-linking": "~57.0.11",
    "expo-router": "~57.0.24",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "^19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "check:tokens": "node src/theme/checks/parity.ts",
    "check:domain": "node src/domain/checks/run.ts",
    "check": "npm run typecheck && npm run check:tokens && npm run check:domain && node design-system/contrast-check.js && node design-system/responsive-check.js",
    "bundle:android": "expo export --platform android --output-dir .expo/bundle-check"
  },
  "private": true
}
