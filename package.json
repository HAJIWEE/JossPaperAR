  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "check:tokens": "node src/theme/checks/parity.ts",
    "check:domain": "node src/domain/checks/run.ts",
    "check:slice": "node src/domain/checks/slice.ts",
    "check:lib": "node src/lib/checks/run.ts",
    "check:pathc": "node supabase/checks/pathc-check.ts",
    "check:sql": "node supabase/checks/sql-structure.js",
    "check:adrs": "node AppDesignConceptBoard/ADRs/check-adrs.js",
    "check:db": "bash supabase/checks/run-sql-tests.sh",
    "check:budget": "bash supabase/checks/exercise-budget.sh",
    "check": "npm run typecheck && npm run check:tokens && npm run check:domain && npm run check:slice && npm run check:pathc && npm run check:sql && npm run check:adrs && node design-system/contrast-check.js && node design-system/responsive-check.js && npm run check:lib",
    "bundle:android": "expo export --platform android --output-dir .expo/bundle-check"
  },
  "private": true
}
